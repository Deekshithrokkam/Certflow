PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# lax for local proxy, Vercel proxy, or same-site custom domains.
# none only for direct cross-site requests (subject to third-party-cookie blocking).
COOKIE_SAME_SITE=lax
# Optional aggregate limits: 0 disables the application cap (default).
# Actual capacity is bounded by hosting, temporary disk, RAM and timeouts.
MAX_ZIP_MB=0
MAX_CSV_MB=0
MAX_EXPANDED_MB=0
MAX_ZIP_ENTRIES=0
MAX_CERTIFICATES=0
MAX_RECIPIENTS=0
