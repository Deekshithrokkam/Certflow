{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":"vite",
  "buildCommand":"npm run build",
  "outputDirectory":"dist",
  "headers":[
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]},
    {"source":"/api/:path*","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"x-vercel-enable-rewrite-caching","value":"0"}]},
    {"source":"/socket.io/:path*","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"x-vercel-enable-rewrite-caching","value":"0"}]}
  ],
  "rewrites":[
    {"source":"/api/:path*","destination":"https://certflow-8o7c.onrender.com/api/:path*"},
    {"source":"/socket.io/:path*","destination":"https://certflow-8o7c.onrender.com/socket.io/:path*"},
    {"source":"/((?!assets/).*)","destination":"/index.html"}
  ]
}
